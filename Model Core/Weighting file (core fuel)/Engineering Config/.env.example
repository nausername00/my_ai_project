# 墨灵环境变量示例：复制为 .env（或直接以环境变量方式注入）

# ---- 推理后端（MODEL_BACKEND: placeholder | ollama | transformers | cloud）----
# MODEL_BACKEND=ollama

# ---- Ollama 后端 ----
# OLLAMA_MODEL=qwen2.5:0.5b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_EXECUTABLE=C:\Users\you\AppData\Local\Programs\Ollama\ollama.exe

# ---- Transformers 后端（需安装 model extra）----
# MODEL_PATH=C:\path\to\model-directory

# ---- 云端 OpenAI 兼容后端（默认关闭；需同时设置三项才会启用）----
# CLOUD_API_MODEL=
# CLOUD_API_BASE_URL=
# CLOUD_API_KEY=
# CLOUD_API_ORG=
# CLOUD_API_PROJECT=

# ---- 角色与记忆 ----
# CHARACTER_CARD_PATH=
# CHARACTER_MEMORY_PATH=
# CHARACTER_ASSET_DIR=
# CHARACTER_PRIVACY_PATH=
# CHARACTER_AFFECT_PATH=

# ---- Agent 工作区 ----
# WORKSPACE_ROOT=
# MOLING_WORKSPACE_ROOT=
# MOLING_TOOL_CAPABILITY=

# ---- 语音 ----
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=zh
# PIPER_VOICE_PATH=C:\path\to\voice.onnx

# ---- 服务 ----
# API_HOST=127.0.0.1
# API_PORT=8000
