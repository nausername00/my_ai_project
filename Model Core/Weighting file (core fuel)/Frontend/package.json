{
  "name": "local-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop MVP for the local AI companion",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check floating-preload.cjs && node --check renderer.js && node --check voice-playback.js && node --check avatar-display.js && node --check mini-game-policy.cjs && node --check mini-game-drafts.cjs && node --check ollama-setup.cjs && node --check voice-resources.cjs && node --check asset-inspector.cjs",
    "test": "node --test ollama-setup.test.cjs voice-resources.test.cjs voice-playback.test.cjs avatar-display.test.cjs floating-avatar.test.cjs mini-game-policy.test.cjs mini-game-drafts.test.cjs notifications.test.cjs social.test.cjs asset-inspector.test.cjs layout.test.cjs trio.test.cjs ocr.test.cjs",
    "test:e2e": "node e2e/e2e-smoke.cjs",
    "build:backend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\\build-backend.ps1",
    "dist:win": "npm run build:backend && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.moling.desktop",
    "productName": "墨灵",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "floating-preload.cjs",
      "index.html",
      "floating.html",
      "voice-playback.js",
      "avatar-display.js",
      "mini-game-policy.cjs",
      "mini-game-drafts.cjs",
      "renderer.js",
      "style.css",
      "ollama-setup.cjs",
      "voice-resources.cjs",
      "asset-inspector.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release-backend/MolingBackend",
        "to": "backend"
      },
      {
        "from": "../Character/assets/voices/zh_CN-huayan-medium.onnx",
        "to": "Character/assets/voices/zh_CN-huayan-medium.onnx"
      },
      {
        "from": "../Character/assets/voices/zh_CN-huayan-medium.onnx.json",
        "to": "Character/assets/voices/zh_CN-huayan-medium.onnx.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨灵"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pixi.js": "^6.5.10"
  },
  "allowScripts": {
    "electron@41.10.7": true
  },
  "dependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "ffmpeg-static": "^5.3.0",
    "pixi-live2d-display": "^0.4.0"
  }
}
